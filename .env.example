# Postgres connection string from Neon (Dashboard > Connect > Prisma / pooled).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The same database, unpooled (Neon: drop the `-pooler` from the host). Used by
# the Prisma CLI only - `prisma migrate deploy` needs a session-level advisory
# lock, which the pooler cannot hold.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# The single admin login. Make the hash with: node scripts/hash-password.mjs "your password"
# In this file every $ in the hash must be escaped as \$ (the script prints that form).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
