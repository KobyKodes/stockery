# Postgres connection string from Neon (Dashboard > Connect > Prisma / pooled).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The same database, unpooled. Copy it from Neon (Connect > untick "Connection
# pooling") rather than hand-editing, so nothing else is lost along with the
# `-pooler`. Used by the Prisma CLI only - `prisma migrate deploy` needs a
# session-level advisory lock, which the pooler cannot hold.
# connect_timeout leaves room for a suspended free-tier compute to wake up.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require&connect_timeout=30"

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# The single admin login. Make the hash with: node scripts/hash-password.mjs "your password"
# In this file every $ in the hash must be escaped as \$ (the script prints that form).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
